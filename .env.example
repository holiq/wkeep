NODE_ENV=development

# Database & Storage
DATABASE_PATH=./data/whatsapp-monitor.sqlite
MEDIA_DIR=./data/media
AUTH_DIR=./auth

# WhatsApp Monitor Configuration
# Comma-separated list of group JIDs to monitor (e.g. 120363xxx@g.us,120363yyy@g.us)
MONITORED_GROUP_IDS=

# Personal monitor group/chat JID where deleted messages are forwarded (e.g. 120363zzz@g.us)
MONITOR_CHAT_ID=

# Retention & Limits
MESSAGE_RETENTION_DAYS=7
MAX_MEDIA_SIZE_MB=50

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

